<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Spectral:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root { --paper:#f3f5f6; --panel:#fff; --ink:#14202b; --muted:#5b6b78; --line:#d5dde2; --grid:#e3e9ed; --accent:#0b6e7a; --warm:#c2410c;
    --font-body:"Instrument Sans",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; --font-head:"Spectral",Georgia,"Times New Roman",serif; color-scheme:light; }
  @media (prefers-color-scheme: dark) { :root { --paper:#10171d; --panel:#172029; --ink:#e7eef2; --muted:#93a4b1; --line:#2a3745; --grid:#212d38; --accent:#5cc3d1; --warm:#f08a3c; color-scheme:dark; } }
  * { box-sizing:border-box; }
  html { -webkit-text-size-adjust:100%; }
  body { margin:0; background:var(--paper); color:var(--ink); font-family:var(--font-body); font-size:15px; line-height:1.55; }
  .wrap { max-width:1200px; margin:0 auto; padding:28px 20px 56px; }
  header { max-width:760px; margin-bottom:26px; }
  h1 { font-family:var(--font-head); font-weight:600; font-size:clamp(28px,4.2vw,40px); line-height:1.12; letter-spacing:-.01em; margin:0 0 10px; }
  header p { margin:0; color:var(--muted); max-width:62ch; }
  .layout { display:grid; grid-template-columns:330px minmax(0,1fr); gap:28px; align-items:start; }
  @media (max-width:880px) { .layout { grid-template-columns:1fr; } }
  .controls { background:var(--panel); border:1px solid var(--line); border-radius:6px; padding:6px 18px 18px; }
  fieldset { border:0; border-top:1px solid var(--line); margin:0; padding:16px 0 4px; min-inline-size:0; }
  fieldset:first-of-type { border-top:0; }
  legend { font-family:var(--font-head); font-weight:600; font-size:17px; padding:0; float:left; width:100%; margin-bottom:10px; }
  legend + * { clear:both; }
  .row { margin-bottom:12px; }
  .row .top { display:flex; justify-content:space-between; align-items:baseline; gap:8px; }
  .row label, .sel label { font-size:14px; }
  .row output { font-variant-numeric:tabular-nums; color:var(--accent); font-weight:600; font-size:14px; }
  input[type=range] { width:100%; margin:4px 0 0; accent-color:var(--accent); }
  .sel { margin-bottom:12px; }
  select { display:block; width:100%; margin-top:4px; font:inherit; font-size:14px; color:var(--ink); background:var(--panel); border:1px solid var(--line); border-radius:4px; padding:6px 8px; }
  .check { display:flex; align-items:center; gap:8px; margin:0 0 12px; font-size:14px; }
  .check input { accent-color:var(--accent); width:16px; height:16px; margin:0; flex:none; }
  .btns { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:8px; }
