  .eq { font-family:"Cambria Math","STIX Two Math",Georgia,serif; background:var(--panel); border:1px solid var(--line); border-radius:4px; padding:10px 14px; margin:10px 0; overflow-x:auto; white-space:nowrap; }
  small { color:var(--muted); }
