<body>
<div class="wrap">
  <header>
    <h1>Inversi VES 1D dengan Grey Wolf Optimizer</h1>
    <p>Buat data sintetik dari model berlapis, lalu cari kembali resistivitas dan ketebalan lapisan dengan algoritma GWO. Semuanya dihitung di browser.</p>
  </header>

  <div class="layout">
    <form class="controls" onsubmit="return false">
      <fieldset>
        <legend>Contoh model sebenarnya</legend>
        <div class="btns">
          <button type="button" data-p="H">Tipe H</button><button type="button" data-p="K">Tipe K</button>
          <button type="button" data-p="Q">Tipe Q</button><button type="button" data-p="A">Tipe A</button>
        </div>
        <div class="btns">
          <button type="button" data-p="m2">2 lapis</button><button type="button" data-p="m3">3 lapis (50/20/300)</button>
        </div>
      </fieldset>
      <fieldset id="fs-true"><legend>Model sebenarnya (data sintetik)</legend></fieldset>
      <fieldset id="fs-ab"><legend>Data observasi</legend></fieldset>
      <fieldset id="fs-gwo">
        <legend>Parameter GWO</legend>
        <div class="sel"><label for="amode">Penurunan parameter a</label>
          <select id="amode"><option value="quad">Kuadratik: a = 2 − 2·iter²/niter² (mGWO)</option><option value="lin">Linear: a = 2 − 2·iter/niter</option></select></div>
        <div class="sel"><label for="wmode">Bobot posisi baru</label>
          <select id="wmode"><option value="mean">Rata-rata (X₁+X₂+X₃)/3</option><option value="w321">Berbobot (3X₁+2X₂+X₃)/6 (mGWO)</option></select></div>
        <div class="sel"><label for="mis">Fungsi misfit</label>
          <select id="mis"><option value="rms">RMS galat relatif (%)</option><option value="mape">Rata-rata galat relatif (%)</option></select></div>
      </fieldset>
      <fieldset>
        <legend>Jalankan</legend>
        <div class="btns">
          <button type="button" class="primary" id="run">Jalankan inversi</button>
          <button type="button" id="stop" disabled>Berhenti</button>
          <button type="button" id="reset">Reset</button>
        </div>
        <label class="check"><input type="checkbox" id="logc" checked> Skala log pada kurva konvergensi</label>
      </fieldset>
    </form>

    <main class="charts">
      <div class="chart-block"><h2>Kurva resistivitas semu</h2><canvas id="c1" role="img" aria-label="Data observasi dan kurva hasil inversi"></canvas></div>
      <div class="chart-block"><h2>Model resistivitas terhadap kedalaman</h2><canvas id="c2" role="img" aria-label="Model sebenarnya dan model hasil inversi"></canvas></div>
      <div class="chart-block"><h2>Kurva konvergensi</h2><canvas id="c3" role="img" aria-label="Misfit alpha, beta, delta dan omega terhadap iterasi"></canvas></div>
      <ul class="stats" id="stats"></ul>
      <div class="tbl" id="res"></div>
    </main>
  </div>

  <section class="notes">
    <h2>Cara membaca</h2>
    <ul>
      <li>Titik adalah data observasi sintetik (dengan noise Gaussian multiplikatif jika diaktifkan). Garis jingga adalah respons model terbaik (serigala α) pada iterasi berjalan.</li>
      <li>Model sebenarnya digambar sebagai tangga solid, model hasil inversi sebagai tangga putus-putus. Lapisan terakhir tidak punya ketebalan karena meluas tak hingga.</li>
      <li>Kurva konvergensi menampilkan misfit α, β, δ (tiga solusi terbaik) dan ω, yaitu misfit serigala terakhir dalam populasi setelah bergerak, seperti pada kode MATLAB.</li>
      <li>Inversi VES tidak unik. Dua model berbeda, terutama dengan lapisan tipis atau kontras kecil, bisa menghasilkan kurva yang hampir sama (ekuivalensi), jadi misfit kecil belum menjamin model sama dengan model sebenarnya.</li>
    </ul>
    <div class="eq">A = 2a·r₁ − a , C = 2r₂ , D = |C·X<sub>pemimpin</sub> − X| , X<sub>k</sub> = X<sub>pemimpin</sub> − A·D , X<sub>baru</sub> = ΣwₖXₖ</div>
    <small>Pemimpin k = α, β, δ. Batas pencarian ρ dan h dijaga dengan memotong nilai di [min, maks]. Forward memakai rekursi resistivitas dan filter 13 koefisien yang sama dengan halaman forward VES 1D.</small>
  </section>
</div>

<script>
// ==ENGINE-START
const NQ = 13, FSH = 10, MS = 4.438, ESTEP = Math.exp(Math.LN10 / (2 * MS)), NS = 2 * NQ - 1;
const FILT = [105, -262, 416, -746, 1605, -4390, 13396, -27841, 16448, 8183, 2525, 336, 225];
const SCR = new Float64Array(NS);

// Forward VES 1D (setara VES1D.m): rho (N), thick (N-1), ab = AB/2
function ves1d(rho, thick, ab, out) {
  out = out || new Float64Array(ab.length);
  const L = rho.length;
  for (let k = 0; k < ab.length; k++) {
    let u = ab[k] * Math.exp(-FSH * Math.LN10 / MS);
    for (let i = 0; i < NS; i++) {
      let t = rho[L - 1];
      for (let w = L - 2; w >= 0; w--) {
        const aa = Math.tanh(thick[w] / u);
        t = (t + rho[w] * aa) / (1 + t * aa / rho[w]);
      }
      SCR[i] = t; u *= ESTEP;
    }
    let s = 0;
    for (let j = 0; j < NQ; j++) s += FILT[j] * SCR[2 * j];
    out[k] = s / 10000;
  }
  return out;
}

// Misfit (%): ganti isinya jika ingin memakai misfit_ves milik Anda
function misfit(obs, cal, kind) {
  const n = obs.length; let s = 0;
  if (kind === 'mape') { for (let i = 0; i < n; i++) s += Math.abs(obs[i] - cal[i]) / obs[i]; return s / n * 100; }
  for (let i = 0; i < n; i++) { const r = (obs[i] - cal[i]) / obs[i]; s += r * r; }
  return Math.sqrt(s / n) * 100;
}

function mulberry32(a) { return function () { a |= 0; a = a + 0x6D2B79F5 | 0; let t = Math.imul(a ^ a >>> 15, 1 | a); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; }; }

// Grey Wolf Optimizer, mengikuti urutan GWO.m: evaluasi + update α/β/δ, lalu gerak semua serigala
function makeGWO(cfg, obs, ab) {
  const np = cfg.npop, nl = cfg.nl, nt = nl - 1, ni = cfg.ni, rnd = mulberry32(cfg.seed);
  const rho = new Float64Array(np * nl), th = new Float64Array(np * nt), buf = new Float64Array(ab.length);
  for (let p = 0; p < np; p++) {
    for (let k = 0; k < nl; k++) rho[p * nl + k] = cfg.rmin + rnd() * (cfg.rmax - cfg.rmin);
    for (let k = 0; k < nt; k++) th[p * nt + k] = cfg.tmin + rnd() * (cfg.tmax - cfg.tmin);
  }
  const lead = [{ s: Infinity }, { s: Infinity }, { s: Infinity }], curves = { a: [], b: [], d: [], o: [] };
  const wt = cfg.wmode === 'w321' ? [3 / 6, 2 / 6, 1 / 6] : [1 / 3, 1 / 3, 1 / 3];
  let iter = 0, evals = 0;
  const fit = p => { evals++; ves1d(rho.subarray(p * nl, (p + 1) * nl), th.subarray(p * nt, (p + 1) * nt), ab, buf); return misfit(obs, buf, cfg.misfit); };
  const keep = (q, f, p) => { lead[q].s = f; lead[q].r = Float64Array.from(rho.subarray(p * nl, (p + 1) * nl)); lead[q].t = Float64Array.from(th.subarray(p * nt, (p + 1) * nt)); };
  function move(x, off, n, lo, hi, key, a) {
    for (let k = 0; k < n; k++) {
      const xi = x[off + k]; let s = 0;
      for (let q = 0; q < 3; q++) {
        const ld = (lead[q][key] || lead[0][key])[k], A = 2 * a * rnd() - a, C = 2 * rnd();
        s += wt[q] * (ld - A * Math.abs(C * ld - xi));
      }
      x[off + k] = Math.min(hi, Math.max(lo, s));
    }
  }
  function step() {
    iter++;
    for (let p = 0; p < np; p++) {
      const f = fit(p);
      if (f < lead[0].s) keep(0, f, p);
      if (f > lead[0].s && f < lead[1].s) keep(1, f, p);
      if (f > lead[0].s && f > lead[1].s && f < lead[2].s) keep(2, f, p);
    }
    const a = cfg.amode === 'lin' ? 2 - iter * 2 / ni : 2 - iter * iter * 2 / (ni * ni);
    for (let p = 0; p < np; p++) { move(rho, p * nl, nl, cfg.rmin, cfg.rmax, 'r', a); move(th, p * nt, nt, cfg.tmin, cfg.tmax, 't', a); }
    curves.a.push(lead[0].s); curves.b.push(lead[1].s); curves.d.push(lead[2].s); curves.o.push(fit(np - 1));
  }
  return { step, lead, curves, cfg, get iter() { return iter; }, get evals() { return evals; } };
}
// ==ENGINE-END

const $ = id => document.getElementById(id);
const SUB = ['₁', '₂', '₃', '₄'];
const state = {
  n: 3, rho: [2000, 100, 800, 100], h: [10, 20, 20], lo: 0, hi: 2.7, np: 25, noise: 0, nseed: 7,
  inv: { npop: 100, nl: 3, ni: 500, rmin: 1, rmax: 2500, tmin: 0, tmax: 100, amode: 'quad', wmode: 'mean', misfit: 'rms', seed: 11 }
};
const PRESETS = {
  H: { n: 3, rho: [2000, 100, 800, 100], h: [10, 20, 20] }, K: { n: 3, rho: [100, 1000, 10, 100], h: [10, 20, 20] },
  Q: { n: 3, rho: [1000, 100, 10, 100], h: [10, 20, 20] },  A: { n: 3, rho: [10, 100, 1000, 100], h: [10, 20, 20] },
  m2: { n: 2, rho: [50, 20, 300, 100], h: [5, 10, 20] },    m3: { n: 3, rho: [50, 20, 300, 100], h: [5, 10, 20] },
};
const rows = [];
const fmtRho = x => x >= 100 ? x.toFixed(0) : x.toFixed(1);
let gwo = null, running = false, raf = 0, tStart = 0, elapsed = 0, cur = null;

function addSlider(box, id, s) {
  const row = document.createElement('div'); row.className = 'row';
  const top = document.createElement('div'); top.className = 'top';
  const lab = document.createElement('label'); lab.htmlFor = id; lab.textContent = s.label;
  const out = document.createElement('output'); out.htmlFor = id; top.append(lab, out);
  const inp = document.createElement('input'); inp.type = 'range'; inp.id = id; inp.min = s.min; inp.max = s.max; inp.step = s.step;
  inp.addEventListener('input', () => { const v = parseFloat(inp.value); s.set(v); out.textContent = s.fmt(s.get()); applyVis(); invalidate(); });
  row.append(top, inp); box.append(row); rows.push({ row, inp, out, s });
}
function syncInputs() { rows.forEach(({ inp, out, s }) => { inp.value = s.get(); out.textContent = s.fmt(s.get()); }); applyVis(); }
function applyVis() { rows.forEach(({ row, s }) => { row.hidden = !(s.vis ? s.vis() : true); }); }

const I = state.inv, ft = $('fs-true');
addSlider(ft, 's-n', { label: 'Jumlah lapisan', min: 2, max: 4, step: 1, get: () => state.n, set: v => state.n = v, fmt: v => String(v) });
for (let i = 0; i < 4; i++) {
  addSlider(ft, 's-r' + i, { label: 'Resistivitas ρ' + SUB[i] + ' (Ω·m)', min: 0, max: 4, step: 0.02, get: () => Math.log10(state.rho[i]), set: v => state.rho[i] = Math.pow(10, v), fmt: v => fmtRho(Math.pow(10, v)), vis: () => i < state.n });
  if (i < 3) addSlider(ft, 's-h' + i, { label: 'Tebal h' + SUB[i] + ' (m)', min: 0.5, max: 100, step: 0.5, get: () => state.h[i], set: v => state.h[i] = v, fmt: v => v.toFixed(1), vis: () => i < state.n - 1 });
}
const fa = $('fs-ab');
addSlider(fa, 's-lo', { label: 'log₁₀ AB/2 awal', min: 0, max: 1.5, step: 0.1, get: () => state.lo, set: v => state.lo = Math.min(v, state.hi - 0.5), fmt: v => v.toFixed(1) + ' (' + fmtRho(Math.pow(10, v)) + ' m)' });
addSlider(fa, 's-hi', { label: 'log₁₀ AB/2 akhir', min: 1.5, max: 3.5, step: 0.1, get: () => state.hi, set: v => state.hi = v, fmt: v => v.toFixed(1) + ' (' + fmtRho(Math.pow(10, v)) + ' m)' });
addSlider(fa, 's-np', { label: 'Jumlah titik ukur', min: 10, max: 40, step: 1, get: () => state.np, set: v => state.np = v, fmt: v => String(v) });
addSlider(fa, 's-nz', { label: 'Noise (% dari ρₐ)', min: 0, max: 15, step: 0.5, get: () => state.noise, set: v => state.noise = v, fmt: v => v.toFixed(1) });
const fg = $('fs-gwo'), selBox = fg.querySelector('.sel');
const gs = [
  { label: 'Jumlah lapisan prediksi', min: 2, max: 4, step: 1, get: () => I.nl, set: v => I.nl = v, fmt: v => String(v) },
  { label: 'Populasi serigala', min: 20, max: 300, step: 10, get: () => I.npop, set: v => I.npop = v, fmt: v => String(v) },
  { label: 'Jumlah iterasi', min: 50, max: 1000, step: 50, get: () => I.ni, set: v => I.ni = v, fmt: v => String(v) },
  { label: 'ρ minimum (Ω·m)', min: 0, max: 2, step: 0.02, get: () => Math.log10(I.rmin), set: v => I.rmin = Math.pow(10, v), fmt: v => fmtRho(Math.pow(10, v)) },
  { label: 'ρ maksimum (Ω·m)', min: 2, max: 4, step: 0.02, get: () => Math.log10(I.rmax), set: v => I.rmax = Math.pow(10, v), fmt: v => fmtRho(Math.pow(10, v)) },
  { label: 'Tebal minimum (m)', min: 0, max: 20, step: 0.5, get: () => I.tmin, set: v => I.tmin = Math.min(v, I.tmax - 1), fmt: v => v.toFixed(1) },
  { label: 'Tebal maksimum (m)', min: 10, max: 300, step: 5, get: () => I.tmax, set: v => I.tmax = Math.max(v, I.tmin + 1), fmt: v => String(v) },
];
const holder = document.createElement('div'); fg.querySelector('legend').after(holder);
gs.forEach((s, i) => addSlider(holder, 'g' + i, s));
[['amode', 'amode'], ['wmode', 'wmode'], ['mis', 'misfit']].forEach(([id, key]) => $(id).addEventListener('change', e => { I[key] = e.target.value; invalidate(); }));

document.querySelectorAll('[data-p]').forEach(b => b.addEventListener('click', () => {
  const p = PRESETS[b.dataset.p]; state.n = p.n; state.rho = p.rho.slice(); state.h = p.h.slice(); I.nl = p.n; syncInputs(); invalidate();
}));
$('logc').addEventListener('change', draw);

// ---------- data observasi ----------
function mkData() {
  const n = state.n, rho = state.rho.slice(0, n), th = state.h.slice(0, n - 1), np = state.np;
  const ab = Float64Array.from({ length: np }, (_, k) => Math.pow(10, state.lo + (state.hi - state.lo) * k / (np - 1)));
  const d = ves1d(rho, th, ab), r = mulberry32(state.nseed), obs = new Float64Array(np);
  for (let k = 0; k < np; k += 2) {
    const u1 = Math.max(r(), 1e-12), u2 = r(), R = Math.sqrt(-2 * Math.log(u1));
    obs[k] = d[k] * Math.max(0.05, 1 + state.noise / 100 * R * Math.cos(2 * Math.PI * u2));
    if (k + 1 < np) obs[k + 1] = d[k + 1] * Math.max(0.05, 1 + state.noise / 100 * R * Math.sin(2 * Math.PI * u2));
  }
  return { ab, d, obs, rho, th };
}
function invalidate() { stopRun(); gwo = null; elapsed = 0; cur = mkData(); render(); }

// ---------- kontrol jalannya inversi ----------
function setBtns() { $('run').disabled = running; $('stop').disabled = !running; }
function stopRun() { running = false; cancelAnimationFrame(raf); setBtns(); }
function startRun() {
  stopRun(); cur = cur || mkData();
  gwo = makeGWO({ ...I }, cur.obs, cur.ab); I.seed++;
  running = true; elapsed = 0; tStart = performance.now(); setBtns(); tick();
}
function tick() {
  if (!running) return;
  const t0 = performance.now();
  while (gwo.iter < gwo.cfg.ni && performance.now() - t0 < 14) gwo.step();
  elapsed = performance.now() - tStart; render();
  if (gwo.iter >= gwo.cfg.ni) stopRun(); else raf = requestAnimationFrame(tick);
}
$('run').addEventListener('click', startRun);
$('stop').addEventListener('click', () => { stopRun(); elapsed = performance.now() - tStart; render(); });
$('reset').addEventListener('click', invalidate);

// ---------- menggambar ----------
const L = 58, R = 16, T = 34, B = 40, T2 = 14;
const cssv = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
const tickTxt = k => String(+Math.pow(10, k).toPrecision(3));
function setup(c, h) {
  const dpr = window.devicePixelRatio || 1, w = c.parentElement.clientWidth - 28;
  c.style.width = w + 'px'; c.style.height = h + 'px'; c.width = Math.round(w * dpr); c.height = Math.round(h * dpr);
  const ctx = c.getContext('2d'); ctx.setTransform(dpr, 0, 0, dpr, 0, 0); return { ctx, w, h };
}
function niceTicks(lo, hi, n) {
  const raw = (hi - lo) / n, p = Math.pow(10, Math.floor(Math.log10(raw))), f = raw / p, step = (f < 1.5 ? 1 : f < 3 ? 2 : f < 7 ? 5 : 10) * p;
  const out = []; for (let t = Math.ceil(lo / step) * step; t <= hi + 1e-9; t += step) out.push(+t.toFixed(10)); return out;
}
function gridLine(ctx, o, q, label, alpha) {   // o: {horiz, a, b, grid, muted}
  q = Math.round(q) + 0.5; ctx.strokeStyle = o.grid; ctx.globalAlpha = alpha; ctx.beginPath();
  if (o.horiz) { ctx.moveTo(q, o.a); ctx.lineTo(q, o.b); } else { ctx.moveTo(o.a, q); ctx.lineTo(o.b, q); }
  ctx.stroke(); ctx.globalAlpha = 1;
  if (label != null) { ctx.fillStyle = o.muted; if (o.horiz) { ctx.textAlign = 'center'; ctx.textBaseline = 'top'; ctx.fillText(label, q, o.b + 8); } else { ctx.textAlign = 'right'; ctx.textBaseline = 'middle'; ctx.fillText(label, o.a - 8, q); } }
}
function logAxis(ctx, o) {   // + o: {lo, hi, pos}
  ctx.lineWidth = 1;
  for (let k = Math.floor(o.lo); k <= Math.ceil(o.hi); k++) for (let m = 1; m < 10; m++) {
    const lg = k + Math.log10(m); if (lg < o.lo - 1e-9 || lg > o.hi + 1e-9) continue;
    gridLine(ctx, o, o.pos(lg), m === 1 ? tickTxt(k) : null, m === 1 ? 1 : 0.45);
  }
}
function linAxis(ctx, o, ticks) { ctx.lineWidth = 1; ticks.forEach(t => gridLine(ctx, o, o.pos(t), String(t), 1)); }
function frame(ctx, pw, ph, top, xl, yl, muted) {
  ctx.strokeStyle = muted; ctx.lineWidth = 1; ctx.strokeRect(L + 0.5, top + 0.5, pw - 1, ph - 1);
  ctx.fillStyle = muted; ctx.textAlign = 'center'; ctx.textBaseline = 'top'; ctx.fillText(xl, L + pw / 2, top + ph + 24);
  ctx.save(); ctx.translate(13, top + ph / 2); ctx.rotate(-Math.PI / 2); ctx.textBaseline = 'middle'; ctx.fillText(yl, 0, 0); ctx.restore();
}
function legend(ctx, items, ink) {
  let x = L; ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
  items.forEach(([txt, col, kind]) => {
    ctx.strokeStyle = col; ctx.fillStyle = col; ctx.lineWidth = 2.4; ctx.setLineDash(kind === 'dash' ? [5, 4] : []);
    if (kind === 'dot') { ctx.beginPath(); ctx.arc(x + 8, 15, 3.2, 0, 7); ctx.fill(); } else { ctx.beginPath(); ctx.moveTo(x, 15); ctx.lineTo(x + 18, 15); ctx.stroke(); }
    ctx.setLineDash([]); ctx.fillStyle = ink; ctx.fillText(txt, x + 24, 15); x += 32 + ctx.measureText(txt).width;
  });
}
function stair(ctx, r, t, X, Y, big, col, dash, wd) {
  ctx.beginPath(); ctx.strokeStyle = col; ctx.lineWidth = wd; ctx.setLineDash(dash); let z = 0;
  for (let i = 0; i < r.length; i++) {
    const x = X(Math.log10(r[i])), z2 = i < t.length ? z + t[i] : big;
    i ? ctx.lineTo(x, Y(z)) : ctx.moveTo(x, Y(0)); ctx.lineTo(x, Y(z2)); z = z2;
  }
  ctx.stroke(); ctx.setLineDash([]);
}
function clip(ctx, x, y, w, h) { ctx.save(); ctx.beginPath(); ctx.rect(x, y, w, h); ctx.clip(); }

function draw() {
  if (!cur) return;
  const ink = cssv('--ink'), muted = cssv('--muted'), grid = cssv('--grid'), accent = cssv('--accent'), warm = cssv('--warm');
  const font = '12px ' + cssv('--font-body'), w0 = $('c1').parentElement.clientWidth - 28, inv = gwo && gwo.lead[0].r ? gwo.lead[0] : null;
  const { ab, obs } = cur, ni = gwo ? gwo.cfg.ni : I.ni;

  // ===== 1: kurva ρa =====
  let { ctx, w, h } = setup($('c1'), Math.max(260, Math.min(380, w0 * 0.5)));
  let pw = w - L - R, ph = h - T - B; ctx.font = font;
  const xlo = Math.floor(Math.log10(ab[0]) + 1e-9); let xhi = Math.ceil(Math.log10(ab[ab.length - 1]) - 1e-9); if (xhi <= xlo) xhi = xlo + 1;
  const ylo = Math.floor(Math.log10(Math.min(...obs)) - 0.15), yhi = Math.max(ylo + 1, Math.ceil(Math.log10(Math.max(...obs)) + 0.15));
  const X = lg => L + (lg - xlo) / (xhi - xlo) * pw, Y = lg => T + (yhi - lg) / (yhi - ylo) * ph;
  logAxis(ctx, { lo: xlo, hi: xhi, horiz: true, pos: X, a: T, b: T + ph, grid, muted });
  logAxis(ctx, { lo: ylo, hi: yhi, horiz: false, pos: Y, a: L, b: L + pw, grid, muted });
  frame(ctx, pw, ph, T, 'AB/2 (m)', 'ρₐ (Ω·m)', muted);
  clip(ctx, L, T, pw, ph);
  if (inv) {
    const cal = ves1d(inv.r, inv.t, ab); ctx.beginPath(); ctx.strokeStyle = warm; ctx.lineWidth = 2.6;
    cal.forEach((v, i) => { const x = X(Math.log10(ab[i])), y = Y(Math.log10(v)); i ? ctx.lineTo(x, y) : ctx.moveTo(x, y); }); ctx.stroke();
  }
  ctx.fillStyle = accent; obs.forEach((v, i) => { ctx.beginPath(); ctx.arc(X(Math.log10(ab[i])), Y(Math.log10(v)), 3.2, 0, 7); ctx.fill(); });
  ctx.restore(); legend(ctx, [['Data observasi', accent, 'dot'], ['Kurva GWO (α)', warm, 'line']], ink);

  // ===== 2: model =====
  ({ ctx, w, h } = setup($('c2'), Math.max(260, Math.min(360, w0 * 0.5)))); ctx.font = font;
  const ph2 = h - T2 - B, sum = cur.th.reduce((s, x) => s + x, 0), Dmax = Math.max(10, sum * 1.6);
  const rlo = Math.floor(Math.log10(Math.min(I.rmin, ...cur.rho)) + 1e-9), rhi = Math.max(rlo + 1, Math.ceil(Math.log10(Math.max(I.rmax, ...cur.rho)) - 1e-9));
  const X2 = lg => L + (lg - rlo) / (rhi - rlo) * pw, Y2 = z => T2 + z / Dmax * ph2;
  logAxis(ctx, { lo: rlo, hi: rhi, horiz: true, pos: X2, a: T2, b: T2 + ph2, grid, muted });
  linAxis(ctx, { horiz: false, a: L, b: L + pw, grid, muted, pos: Y2 }, niceTicks(0, Dmax, 5));
  frame(ctx, pw, ph2, T2, 'Resistivitas (Ω·m)', 'Kedalaman (m)', muted);
  clip(ctx, L, T2, pw, ph2);
  stair(ctx, cur.rho, cur.th, X2, Y2, Dmax * 3, accent, [], 2.8);
  if (inv) stair(ctx, inv.r, inv.t, X2, Y2, Dmax * 3, warm, [6, 4], 2.8);
  ctx.restore();
  ctx.font = font; ctx.textAlign = 'left'; ctx.textBaseline = 'middle'; ctx.fillStyle = ink;
  ctx.strokeStyle = accent; ctx.lineWidth = 2.8; ctx.beginPath(); ctx.moveTo(L + 8, T2 + 12); ctx.lineTo(L + 28, T2 + 12); ctx.stroke(); ctx.fillText('Model sebenarnya', L + 34, T2 + 12);
  ctx.strokeStyle = warm; ctx.setLineDash([6, 4]); ctx.beginPath(); ctx.moveTo(L + 8, T2 + 30); ctx.lineTo(L + 28, T2 + 30); ctx.stroke(); ctx.setLineDash([]); ctx.fillText('Model GWO', L + 34, T2 + 30);

  // ===== 3: konvergensi =====
  ({ ctx, w, h } = setup($('c3'), Math.max(240, Math.min(320, w0 * 0.45)))); ctx.font = font;
  ph = h - T - B; const c = gwo ? gwo.curves : { a: [], b: [], d: [], o: [] }, lg = $('logc').checked;
  const ser = [[c.a, warm, 'α (alpha)'], [c.b, accent, 'β (beta)'], [c.d, '#a24fb3', 'δ (delta)'], [c.o, '#5a9a3c', 'ω (omega)']];
  const fin = ser.flatMap(s => s[0]).filter(isFinite), mx = fin.length ? Math.max(...fin) : 1;
  const tr = v => Math.log10(Math.max(v, 1e-4)), Xc = it => L + it / ni * pw;
  linAxis(ctx, { horiz: true, a: T, b: T + ph, grid, muted, pos: Xc }, niceTicks(0, ni, 6));
  let Yc;
  if (lg) {
    const vs = fin.length ? fin.map(tr) : [0, 1], lo = Math.floor(Math.min(...vs)), hi = Math.max(lo + 1, Math.ceil(Math.max(...vs)));
    Yc = v => T + (hi - tr(v)) / (hi - lo) * ph; logAxis(ctx, { lo, hi, horiz: false, pos: q => T + (hi - q) / (hi - lo) * ph, a: L, b: L + pw, grid, muted });
  } else {
    const top = mx * 1.05; Yc = v => T + (1 - v / top) * ph; linAxis(ctx, { horiz: false, a: L, b: L + pw, grid, muted, pos: Yc }, niceTicks(0, top, 5));
  }
  frame(ctx, pw, ph, T, 'Iterasi', 'Misfit (%)', muted);
  clip(ctx, L, T, pw, ph);
  ser.forEach(([arr, col]) => {
    ctx.beginPath(); ctx.strokeStyle = col; ctx.lineWidth = 2; let pen = false;
    arr.forEach((v, i) => { if (!isFinite(v)) { pen = false; return; } const x = Xc(i + 1), y = Yc(v); pen ? ctx.lineTo(x, y) : ctx.moveTo(x, y); pen = true; }); ctx.stroke();
  });
  ctx.restore(); legend(ctx, ser.map(s => [s[2], s[1], 'line']), ink);
}

function render() {
  draw();
  const g = gwo, n = cur.rho.length, nl = g ? g.cfg.nl : I.nl, inv = g && g.lead[0].r ? g.lead[0] : null;
  $('stats').innerHTML = g
    ? `<li>Iterasi <b>${g.iter} / ${g.cfg.ni}</b></li><li>Misfit α <b>${isFinite(g.lead[0].s) ? g.lead[0].s.toFixed(3) : '–'} %</b></li>` +
      `<li>Evaluasi forward <b>${g.evals}</b></li><li>Waktu <b>${(elapsed / 1000).toFixed(2)} s</b></li><li>Seed <b>${g.cfg.seed}</b></li>`
    : '<li>Atur model dan parameter, lalu klik <b>Jalankan inversi</b>.</li>';
  let html = '<table><thead><tr><th>Lapisan</th><th>ρ sebenarnya (Ω·m)</th><th>ρ GWO (Ω·m)</th><th>h sebenarnya (m)</th><th>h GWO (m)</th></tr></thead><tbody>';
  for (let i = 0; i < Math.max(n, nl); i++) {
    html += `<tr><td>${i + 1}</td><td>${i < n ? fmtRho(cur.rho[i]) : '–'}</td><td>${inv && i < nl ? fmtRho(inv.r[i]) : '–'}</td>` +
      `<td>${i < n - 1 ? cur.th[i].toFixed(1) : i < n ? '∞' : '–'}</td><td>${inv && i < nl - 1 ? inv.t[i].toFixed(1) : inv && i < nl ? '∞' : '–'}</td></tr>`;
  }
  $('res').innerHTML = html + '</tbody></table>';
}

window.addEventListener('resize', () => { if (cur) draw(); });
window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => { if (cur) draw(); });
if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => { if (cur) draw(); });

// ---------- mulai ----------
syncInputs(); setBtns(); invalidate();
</script>
</body>
</html>
